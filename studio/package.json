    "lighthouse": "node preview/lighthouse.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "esbuild": "0.28.2",
