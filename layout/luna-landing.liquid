<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <title>
      {{- page_title -}}
      {%- unless page_title contains shop.name %} · {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description != blank %}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif %}
    <link rel="canonical" href="{{ canonical_url }}">

    {%- liquid
      assign luna_og_variant = product.selected_or_first_available_variant
      assign luna_og_units = luna_og_variant.price | divided_by: 100
      assign luna_og_cents = luna_og_variant.price | modulo: 100
      assign luna_og_description = page_description | default: shop.description
    %}
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:type" content="product">
    <meta property="og:title" content="{{ page_title | escape }}">
    {%- if luna_og_description != blank %}
      <meta property="og:description" content="{{ luna_og_description | escape }}">
    {%- endif %}
    {%- if product.featured_image %}
      <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
      <meta property="og:image:secure_url" content="https:{{ product.featured_image | image_url: width: 1200 }}">
      <meta property="og:image:width" content="1200">
      <meta
        property="og:image:height"
        content="{{ 1200 | divided_by: product.featured_image.aspect_ratio | round }}"
      >
    {%- endif %}
    {%- if luna_og_variant %}
      <meta
        property="product:price:amount"
        content="{{ luna_og_units }}.{% if luna_og_cents < 10 %}0{% endif %}{{ luna_og_cents }}"
      >
      <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
    {%- endif %}
    <meta name="theme-color" content="#05060B">

    <style>
      @font-face {
        font-family: 'Luna Fraunces';
        src: url('{{ 'luna-fraunces.woff2' | asset_url }}') format('woff2');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Luna Inter';
        src: url('{{ 'luna-inter.woff2' | asset_url }}') format('woff2');
        font-weight: 100 900;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Luna Inter Fallback';
        src: local('Arial');
        size-adjust: 107%;
        ascent-override: 90%;
        descent-override: 22.4%;
        line-gap-override: 0%;
      }
    </style>
    {{ 'luna-fraunces.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'luna-inter.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'luna-landing.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="luna-body{% if request.design_mode %} luna-is-editor{% endif %}">
    <div class="luna-sky" aria-hidden="true">
      <div class="luna-sky__nebula luna-sky__nebula--a"></div>
      <div class="luna-sky__nebula luna-sky__nebula--b"></div>
      <div class="luna-sky__nebula luna-sky__nebula--c"></div>
      <div class="luna-sky__stars"></div>
      <div class="luna-sky__glow"></div>
      <div class="luna-sky__grain"></div>
    </div>

    <main id="luna-main" class="luna-page">
      {{ content_for_layout }}
    </main>

    <script src="{{ 'luna-landing.js' | asset_url }}" defer></script>
  </body>
</html>
