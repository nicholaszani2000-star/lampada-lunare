{%- doc -%}
  Prezzo, prezzo barrato, percentuale di sconto, risparmio, riga Omnibus e IVA (§4.6).
  Tutti i numeri arrivano da Shopify: niente prezzi scritti a mano.
  Barrato, badge, risparmio e riga Omnibus compaiono solo se compare_at_price è maggiore di price.
  Layout 'large' (hero e offerta): tutto. Layout 'compact' (barra sticky): prezzo, barrato e riga Omnibus.

  @param {product} product - Il prodotto
  @param {object} [variant] - La variante da mostrare (predefinita: selezionata o prima disponibile)
  @param {string} [layout] - 'large' oppure 'compact' (predefinito 'large')
  @param {string} [badge_text] - Testo del badge, {pct} diventa la percentuale (predefinito «−{pct}%»)
  @param {boolean} [show_savings] - Mostra il risparmio nel layout large (predefinito sì)
  @param {string} [savings_text] - Testo del risparmio, {importo} diventa la cifra (predefinito «Risparmi {importo}»)
  @param {string} [omnibus_text] - Testo prima del prezzo più basso degli ultimi 30 giorni
  @param {string} [tax_text] - Testo mostrato quando i prezzi includono l'IVA
  @param {string} [sale_label] - Etichetta per i lettori di schermo del prezzo attuale
  @param {string} [regular_label] - Etichetta per i lettori di schermo del prezzo barrato
{%- enddoc -%}
{%- liquid
  assign luna_variant = variant | default: product.selected_or_first_available_variant
  assign luna_layout = layout | default: 'large'
  assign luna_show_savings = show_savings | default: true, allow_false: true
  assign luna_badge_text = badge_text | default: '−{pct}%'
  assign luna_savings_text = savings_text | default: 'Risparmi {importo}'
  assign luna_omnibus_text = omnibus_text | default: 'Prezzo più basso degli ultimi 30 giorni:'
  assign luna_tax_text = tax_text | default: 'IVA inclusa'
  assign luna_sale_label = sale_label | default: 'Prezzo attuale'
  assign luna_regular_label = regular_label | default: 'Prezzo di listino'

  assign luna_on_sale = false
  if luna_variant.compare_at_price > luna_variant.price
    assign luna_on_sale = true
    assign luna_pct = luna_variant.compare_at_price | minus: luna_variant.price | times: 100.0 | divided_by: luna_variant.compare_at_price | round
    assign luna_savings = luna_variant.compare_at_price | minus: luna_variant.price | money
    assign luna_savings_html = '<span data-luna-save>' | append: luna_savings | append: '</span>'
  endif
-%}
<div
  class="luna-price luna-price--{{ luna_layout }}{% if luna_on_sale %} is-on-sale{% endif %}"
  data-luna-price-block
>
  <p class="luna-price__row">
    <span class="luna-visually-hidden">{{ luna_sale_label | escape }}</span>
    <span class="luna-price__now" data-luna-price>{{ luna_variant.price | money }}</span>
    {%- if luna_on_sale %}
      <span class="luna-price__was">
        <span class="luna-visually-hidden">{{ luna_regular_label | escape }}</span>
        <s data-luna-compare>{{ luna_variant.compare_at_price | money }}</s>
      </span>
      {%- if luna_layout == 'large' %}
        <span class="luna-badge luna-badge--sale" data-luna-pct>
          {{- luna_badge_text | escape | replace: '{pct}', luna_pct -}}
        </span>
      {%- endif -%}
    {%- endif -%}
  </p>
  {%- if luna_on_sale and luna_layout == 'large' and luna_show_savings -%}
    <p class="luna-price__save">
      {{- luna_savings_text | escape | replace: '{importo}', luna_savings_html -}}
    </p>
  {%- endif -%}
  {%- if luna_on_sale -%}
    <p class="luna-price__omnibus">
      {{ luna_omnibus_text | escape }}
      <span data-luna-omnibus>{{ luna_variant.compare_at_price | money }}</span>
    </p>
  {%- endif -%}
  {%- if cart.taxes_included and luna_layout == 'large' -%}
    <p class="luna-price__tax">{{ luna_tax_text | escape }}</p>
  {%- endif -%}
</div>
