{%- doc -%}
  Icone SVG inline della landing, tratto 1,5 e colore currentColor.

  @param {string} name - luna, camion, scudo, reso, spunta, croce, scintilla, regalo, stella, tocco, accensione, freccia, calamita, luce
  @param {number} [size] - Lato in px (predefinito 24)
  @param {string} [class] - Classi CSS aggiuntive
  @param {string} [label] - Testo per i lettori di schermo; se manca l'icona è decorativa
  @param {boolean} [filled] - Riempie la forma (utile per la stella)
{%- enddoc -%}
{%- liquid
  assign icon_size = size | default: 24
  assign icon_fill = 'none'
  if filled
    assign icon_fill = 'currentColor'
  endif
-%}
<svg
  class="luna-icon luna-icon--{{ name }}{% if class != blank %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="{{ icon_fill }}"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  {% if label != blank %}
    role="img" aria-label="{{ label | escape }}"
  {% else %}
    aria-hidden="true"
  {% endif %}
>
  {%- case name -%}
    {%- when 'luna' -%}
      <path d="M20.25 14.6A8.25 8.25 0 1 1 9.4 3.75a6.6 6.6 0 0 0 10.85 10.85Z"/>
    {%- when 'camion' -%}
      <path d="M2.75 6.25h11v9.5h-11z"/><path d="M13.75 9.25h3.7l2.8 3.1v3.4h-6.5"/><circle cx="6.75" cy="17.25" r="1.75"/><circle cx="17" cy="17.25" r="1.75"/>
    {%- when 'scudo' -%}
      <path d="M12 3.25 19 6v5.4c0 4.35-2.95 7.85-7 9.35-4.05-1.5-7-5-7-9.35V6l7-2.75Z"/><path d="m9.1 12.1 2 2 3.8-3.95"/>
    {%- when 'reso' -%}
      <path d="M4.75 4.75v4.5h4.5"/><path d="M5.2 9.25A7.75 7.75 0 1 1 4.5 14"/>
    {%- when 'spunta' -%}
      <path d="m5 12.5 4.5 4.5 9.5-9.5"/>
    {%- when 'croce' -%}
      <path d="m6.5 6.5 11 11M17.5 6.5l-11 11"/>
    {%- when 'scintilla' -%}
      <path d="M12 3.5c.7 5 3.5 7.8 8.5 8.5-5 .7-7.8 3.5-8.5 8.5-.7-5-3.5-7.8-8.5-8.5 5-.7 7.8-3.5 8.5-8.5Z"/>
    {%- when 'regalo' -%}
      <rect x="3.75" y="8.25" width="16.5" height="4" rx="1"/><path d="M5.25 12.25v8h13.5v-8M12 8.25v12"/><path d="M12 8.25C10.6 4.9 6.75 4.4 6.75 6.7c0 1.15 1.25 1.55 5.25 1.55Zm0 0c1.4-3.35 5.25-3.85 5.25-1.55 0 1.15-1.25 1.55-5.25 1.55Z"/>
    {%- when 'stella' -%}
      <path d="m12 3.5 2.6 5.3 5.9.85-4.25 4.15 1 5.85L12 16.9l-5.25 2.75 1-5.85L3.5 9.65l5.9-.85L12 3.5Z"/>
    {%- when 'tocco' -%}
      <path d="M9.75 13.25v-7.5a1.5 1.5 0 0 1 3 0v5.5"/><path d="M12.75 10.75a1.5 1.5 0 0 1 3 0v1"/><path d="M15.75 11.5a1.5 1.5 0 0 1 3 0v3.25c0 3.45-2.35 6-5.6 6h-.9c-1.9 0-3.2-.85-4.25-2.3l-2.6-3.6a1.45 1.45 0 0 1 2.25-1.8l2.1 2.2"/><path d="M6.6 6.1a4.9 4.9 0 0 1 1.85-2.6M15.9 3.5a4.9 4.9 0 0 1 1.85 2.6"/>
    {%- when 'accensione' -%}
      <path d="M12 3.5v7.25"/><path d="M7.45 6.35a7.25 7.25 0 1 0 9.1 0"/>
    {%- when 'freccia' -%}
      <path d="M4.5 12h15M13.5 6l6 6-6 6"/>
    {%- when 'calamita' -%}
      <path d="M6.25 4.25h3.5v8a2.25 2.25 0 0 0 4.5 0v-8h3.5v8a5.75 5.75 0 0 1-11.5 0v-8Z"/><path d="M6.25 8.25h3.5M14.25 8.25h3.5"/>
    {%- when 'luce' -%}
      <circle cx="12" cy="12" r="3.75"/><path d="M12 2.75v2M12 19.25v2M2.75 12h2M19.25 12h2M5.45 5.45l1.4 1.4M17.15 17.15l1.4 1.4M5.45 18.55l1.4-1.4M17.15 6.85l1.4-1.4"/>
  {%- endcase -%}
</svg>
